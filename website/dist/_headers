/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://lab.magiconch.com; connect-src 'self' https://aud-api.utae.cn ws://127.0.0.1:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'self' https://openapi.alipay.com https://unitradeprod.alipay.com https://excashier.alipay.com; frame-ancestors 'none'

/releases/*
  Cache-Control: no-cache

/data/*.json
  Cache-Control: no-cache

/gallery/*.json
  Cache-Control: no-cache

/sdk/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/sdk/1.0.0/audcore.d.ts
  Content-Type: text/plain; charset=utf-8


/sdk/1.1.0/audcore.d.ts
  Content-Type: text/plain; charset=utf-8

/source/*
  Cache-Control: no-store
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: loopback-network=(self), local-network=(self)

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=3600, must-revalidate

/skin-dev/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache


/skin-dev/audcore_skin.h
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

/skin-dev/*.zip
  Cache-Control: no-cache

/io-dev/development.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-cache

/io-dev/audcore-io-example.zip
  Content-Type: application/zip
  Cache-Control: no-cache

/io-dev/audcore-io-development.pptx
  Content-Type: application/vnd.openxmlformats-officedocument.presentationml.presentation
  Cache-Control: no-cache
