/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://lab.magiconch.com; connect-src 'self' https://aud-api.utae.cn; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/releases/*
  Cache-Control: no-cache

/data/*.json
  Cache-Control: no-cache

/gallery/*.json
  Cache-Control: no-cache
